{
    "name": "medistore/online-pharmacy",
    "description": "MediStore - Online Pharmacy with Prescription Upload and Order Tracking",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.5",
        "dompdf/dompdf": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php spark migrate --all",
            "@php spark db:seed DatabaseSeeder"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
