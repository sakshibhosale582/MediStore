#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/MediStore/public/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = medistore
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
encryption.key = hex2bin:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
# Left at framework defaults (Config\Session::$driver / $savePath),
# which correctly resolve to writable/session/. Do NOT set
# session.savePath here as the string "null" — CI4's .env parser has
# no special null-casting, so it would be taken literally and used as
# a relative path, creating a "null" folder inside the public webroot.

#--------------------------------------------------------------------
# EMAIL (Dummy)
#--------------------------------------------------------------------
email.fromEmail = noreply@medistore.com
email.fromName = MediStore
email.protocol = mail
